# PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/chunkjournal"

# S3-compatible storage (Cloudflare R2, MinIO, Backblaze B2, etc.)
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="chunkjournal"

# Admin password for uploads / edits
ADMIN_TOKEN="change-me-to-a-random-secret"
